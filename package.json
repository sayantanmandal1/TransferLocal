{
  "name": "transfer",
  "version": "1.0.0",
  "description": "Peer-to-peer local network file transfer with polished UI",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"node server/index.js\" \"cd client && npx vite --host\"",
    "build": "cd client && npx vite build",
    "postinstall": "cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "multer": "^1.4.5-lts.1",
    "selfsigned": "^2.4.1",
    "uuid": "^9.0.0",
    "crc-32": "^1.2.2",
    "mime-types": "^2.1.35",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
